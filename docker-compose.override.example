# Local Compose override EXAMPLE — copy to docker-compose.override.yml
#
# Upgrade note: if you already have a local docker-compose.override.yml, Compose
# still auto-loads it (merge with docker-compose.yml). That preserves mounts and
# LLM settings. The real override file is gitignored; this .example is tracked.
#
# Docker Compose merges this file with docker-compose.yml. Listing `volumes` here
# replaces the entire `volumes` array for transcriptx-web, so we repeat the same
# mounts as the base file but drop the `:ro` flag on transcripts so the app can
# write `.speaker_map.json` sidecars next to transcript JSON files.
#
# Mount ./src so sidebar and other web UI edits apply without rebuilding the image.
# For production-like read-only transcripts, use only docker-compose.yml (or delete
# this file) so /mnt/transcripts stays :ro.
#
# Mac / Apple Silicon: use CPU-only PyTorch wheels at build time (no 500MB+ NVIDIA
# CUDA deps; Docker on Mac cannot use GPU anyway). Override via .env if needed.
#
# Local LLM defaults: enable Ollama + Corrections Studio discovery when unset in
# .env (see docs/runtime/corrections-llm.md). Requires Ollama on the host.
services:
  transcriptx-web:
    build:
      args:
        TRANSCRIPTX_TORCH_VARIANT: cpu
    environment:
      - TRANSCRIPTX_LLM_ENABLED=${TRANSCRIPTX_LLM_ENABLED:-1}
      - TRANSCRIPTX_LLM_PROVIDER=${TRANSCRIPTX_LLM_PROVIDER:-ollama}
      - TRANSCRIPTX_LLM_MODEL=${TRANSCRIPTX_LLM_MODEL:-qwen3:8b}
      - TRANSCRIPTX_LLM_BASE_URL=${TRANSCRIPTX_LLM_BASE_URL:-http://host.docker.internal:11434}
      - TRANSCRIPTX_CORRECTIONS_LLM_ENABLED=${TRANSCRIPTX_CORRECTIONS_LLM_ENABLED:-1}
    volumes:
      - ./data:/data
      - ${HOST_CONFIG_DIR:-./data/.transcriptx}:/data/.transcriptx
      - transcriptx_cache:/home/transcriptx/.cache
      - ./src/transcriptx:/opt/venv/lib/python3.10/site-packages/transcriptx
      - ${HOST_TRANSCRIPTS_DIR:-./data/transcripts}:/mnt/transcripts
      - ${HOST_TRANSCRIPT_INBOX_DIR:-./data/transcript-inbox}:/mnt/transcript-inbox:ro
      - ${HOST_OUTPUT_DIR:-./data/outputs}:/mnt/outputs
      - ${HOST_RECORDINGS_DIR:?Set HOST_RECORDINGS_DIR in .env to your host recordings folder outside the repo}:/mnt/recordings
      - ${HOST_RECORDINGS_DIR:?Set HOST_RECORDINGS_DIR in .env to your host recordings folder outside the repo}/imports:/mnt/recordings/imports
      - ${HOST_WAV_BACKUP_DIR:-./data/backups/wav}:/mnt/wav
