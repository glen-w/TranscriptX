    "max_iter_lda": 50,
    "max_iter_nmf": 10000,
    "alpha_H": 0.1,
    "tol": 0.01,
    "learning_method": "batch",
    "k_range": [
      3,
      15
    ],
    "test_size": 0.2
  }
}