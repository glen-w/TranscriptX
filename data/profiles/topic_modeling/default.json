{
  "name": "default",
  "module": "topic_modeling",
  "description": "Default topic modeling profile with balanced settings",
  "config": {
    "max_features": 1000,
    "min_df": 2,
    "max_df": 0.95,
    "ngram_range": [
      1,
      2
