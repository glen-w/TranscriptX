# Copy to `.env` and set values as needed. Repo root `.env` is loaded by
# `transcriptx._bootstrap` before paths/config are resolved.
#
# HOST_* — used by docker-compose.yml for volume mount sources on the host.
# TRANSCRIPTX_* — used by the app (native runs and container env in compose).

# -----------------------------------------------------------------------------
# Docker Compose: host paths for volume mounts
# -----------------------------------------------------------------------------
# Recordings: required for `docker compose`. Use an absolute path outside the git
# clone (your audio library). Create `imports/` there for uploads if needed.
# Example: HOST_RECORDINGS_DIR=/Users/you/Documents/TranscriptX-media/recordings
HOST_TRANSCRIPTS_DIR=
HOST_RECORDINGS_DIR=
HOST_WAV_BACKUP_DIR=
HOST_OUTPUT_DIR=

# Docker image build: PyTorch wheel variant (build-time only; see docs/runtime/docker.md).
# default — PyPI torch (includes CUDA wheels on arm64; use on Linux + NVIDIA GPU).
# cpu     — CPU-only PyTorch index (smaller/faster builds; recommended on Mac).
TRANSCRIPTX_TORCH_VARIANT=

# -----------------------------------------------------------------------------
# Storage & paths (native / overrides; in Docker these are usually set in compose)
# -----------------------------------------------------------------------------
TRANSCRIPTX_DATA_DIR=
TRANSCRIPTX_CONFIG_DIR=
TRANSCRIPTX_PROFILES_DIR=
TRANSCRIPTX_TRANSCRIPTS_DIR=
TRANSCRIPTX_RECORDINGS_DIR=
TRANSCRIPTX_OUTPUT_DIR=
TRANSCRIPTX_WAV_BACKUP_DIR=
# Deprecated: prefer TRANSCRIPTX_WAV_BACKUP_DIR
TRANSCRIPTX_WAV_STORAGE_DIR=
TRANSCRIPTX_IMPORTS_DIR=

# Host-side batch transcription (scripts/whispermlx-missing.py + whispermlx provider)
# Optional provider id for TranscriptionOptions (default: whispermlx)
TRANSCRIPTX_TRANSCRIPTION_PROVIDER=
# Optional: full path to whispermlx binary when it is not on PATH
WHISPERMLX=
# Model / language / diarization defaults for WhisperMLX (optional; provider defaults apply)
WHISPERMLX_MODEL=
WHISPERMLX_LANGUAGE=
WHISPERMLX_DIARIZE=
# Optional wall-clock timeout in seconds (0 = no timeout)
WHISPERMLX_TIMEOUT_SECONDS=
# Optional override for local JSON config path (default: .transcriptx/whispermlx-missing.json)
WHISPERMLX_MISSING_CONFIG=

# -----------------------------------------------------------------------------
# Core install profile & optional dependency behavior
# -----------------------------------------------------------------------------
# 1/true/yes/on = core-only (no heavy auto-install paths)
TRANSCRIPTX_CORE=
# 1/true/yes/on = never auto-install optional packages at import time
TRANSCRIPTX_NO_AUTO_INSTALL=
# Default when unset: downloads enabled. 1/true/yes/on = disable downloads
TRANSCRIPTX_DISABLE_DOWNLOADS=
# Unset = allow spaCy model auto-download when needed; 1/true = skip download
TRANSCRIPTX_DISABLE_SPACY_DOWNLOAD=
# 1/true/yes/on = strict env key handling (unknown TRANSCRIPTX_* keys raise)
TRANSCRIPTX_CONFIG_STRICT=
# 1/true/yes/on = allow analysis on transcripts without managed-import sidecar
# (development/tests only; default off for production workflows)
TRANSCRIPTX_ALLOW_UNMANAGED_TRANSCRIPTS=

# -----------------------------------------------------------------------------
# Web entrypoint defaults (see transcriptx.web.__main__)
# -----------------------------------------------------------------------------
TRANSCRIPTX_HOST=
TRANSCRIPTX_PORT=

# -----------------------------------------------------------------------------
# UI / logging
# -----------------------------------------------------------------------------
# 1/true/yes/on or 0/false/no/off
TRANSCRIPTX_USE_EMOJIS=
TRANSCRIPTX_LOG_LEVEL=
# 1/0 — passed to matplotlib figure max open warning (see lazy_imports)
TRANSCRIPTX_MPL_MAX_OPEN_WARNING=
# 1 = enable Corrections Studio page; other = off
TRANSCRIPTX_ENABLE_CORRECTIONS_STUDIO=

# -----------------------------------------------------------------------------
# Config overrides (applied by env_key_registry.apply_env_to_config via
# env_overrides.apply_transcriptx_env and system_env.apply_env_overrides)
# -----------------------------------------------------------------------------
# Rolling window (segments) for sentiment aggregation
TRANSCRIPTX_SENTIMENT_WINDOW_SIZE=

# Transcript metadata listing and duration (optional overrides)
# Duration: max_end | span (default max_end)
TRANSCRIPTX_METADATA_DURATION_CALCULATION=
# Word count for listings: in_memory | metadata_only (default in_memory)
TRANSCRIPTX_METADATA_LISTING_WORD_COUNT_FALLBACK=
# 1/true/yes/on = refresh metadata index after writes
TRANSCRIPTX_METADATA_AUTO_REFRESH_ON_WRITE=
# 1/true/yes/on = expose legacy words field alias in metadata
TRANSCRIPTX_METADATA_LEGACY_WORDS_ALIAS=

# Dashboard duration display (optional overrides)
# Seconds threshold before showing hours in duration summaries (default in config)
TRANSCRIPTX_DASHBOARD_DURATION_HOURS_THRESHOLD=
# compact | minutes_only
TRANSCRIPTX_DASHBOARD_DURATION_SUMMARY_STYLE=

# -----------------------------------------------------------------------------
# Analysis models — optional overrides (defaults are CPU-friendly English).
# Full guide: docs/runtime/models.md. Docker: set here in .env; compose passes
# model vars into the container (see docker-compose.yml).
# -----------------------------------------------------------------------------
# Hugging Face tokenizers: avoid fork deadlocks in multi-process pipelines.
# Optional — pipeline.py sets "false" on import if unset. Set explicitly to
# override (true|false).
TOKENIZERS_PARALLELISM=false
# spaCy — NER, highlights, insight eligibility (shared across modules).
# Options: en_core_web_sm (fast) | en_core_web_md (default, in Docker image)
#          en_core_web_lg (slower, better NER) | en_core_web_trf (slowest, best)
TRANSCRIPTX_SPACY_MODEL=
# Hugging Face emotion classifier (transformer leg; NRCLex still runs).
# Default: bhadresh-savani/distilbert-base-uncased-emotion
# Example upgrade: j-hartmann/emotion-english-distilroberta-base
TRANSCRIPTX_EMOTION_MODEL=
# Sentence-transformers for legacy semantic_similarity and echoes paraphrase.
# Default: sentence-transformers/all-MiniLM-L6-v2
# Example upgrade: sentence-transformers/all-mpnet-base-v2
TRANSCRIPTX_SEMANTIC_MODEL=
# Embedding model for semantic_similarity_v2 only (separate from SEMANTIC_MODEL).
# Default if unset: sentence-transformers/all-MiniLM-L6-v2
# Example upgrade: sentence-transformers/all-mpnet-base-v2
TRANSCRIPTX_SEMANTIC_V2_MODEL=
# Sentiment backend. Default: vader (lexicon, fast).
# Options: vader | transformers (uses sentiment_model_name in config/UI)
#          | textblob (offline fallback)
TRANSCRIPTX_SENTIMENT_BACKEND=
# BERTopic module embeddings only (not LDA/NMF topic_modeling).
# Default: all-MiniLM-L6-v2 — short name or full sentence-transformers/... path
# Example upgrade: sentence-transformers/all-mpnet-base-v2
TRANSCRIPTX_BERTOPIC_EMBEDDING_MODEL=
# Dialogue acts ML model name — low impact today (transformer path disabled).
# Default in config: bert-base-uncased
TRANSCRIPTX_ACTS_MODEL=

# Heartbeat cadence for semantic_similarity_advanced progress logs (seconds)
TRANSCRIPTX_SEMANTIC_PROGRESS_LOG_INTERVAL_SECONDS=
# Heartbeat cadence for long-running module execution logs (seconds)
TRANSCRIPTX_MODULE_PROGRESS_LOG_INTERVAL_SECONDS=
TRANSCRIPTX_WORDCLOUD_MAX_WORDS=
# JSON list or comma-separated paths
TRANSCRIPTX_WAV_FOLDERS=
TRANSCRIPTX_RECORDINGS_FOLDERS=
# prompt | explore | direct
TRANSCRIPTX_FILE_SELECTION_MODE=

# -----------------------------------------------------------------------------
# Audio preprocessing (modes: selected | auto | suggest | off where applicable)
# -----------------------------------------------------------------------------
TRANSCRIPTX_AUDIO_PREPROCESSING_MODE=
TRANSCRIPTX_AUDIO_CONVERT_TO_MONO=
TRANSCRIPTX_AUDIO_DOWNSAMPLE=
TRANSCRIPTX_AUDIO_TARGET_SAMPLE_RATE=
TRANSCRIPTX_AUDIO_NORMALIZE_MODE=
TRANSCRIPTX_AUDIO_NORMALIZE_ENABLED=
TRANSCRIPTX_AUDIO_TARGET_LUFS=
TRANSCRIPTX_AUDIO_DENOISE_MODE=
TRANSCRIPTX_AUDIO_DENOISE_ENABLED=
TRANSCRIPTX_AUDIO_DENOISE_STRENGTH=
TRANSCRIPTX_AUDIO_HIGHPASS_MODE=
TRANSCRIPTX_AUDIO_HIGHPASS_ENABLED=
TRANSCRIPTX_AUDIO_HIGHPASS_CUTOFF=

# -----------------------------------------------------------------------------
# Speaker gate (workflow.speaker_gate; strings interpreted by gate config)
# -----------------------------------------------------------------------------
TRANSCRIPTX_SPEAKER_GATE_THRESHOLD_VALUE=
TRANSCRIPTX_SPEAKER_GATE_THRESHOLD_TYPE=
TRANSCRIPTX_SPEAKER_GATE_MODE=
TRANSCRIPTX_SPEAKER_GATE_EXEMPLAR_COUNT=

# -----------------------------------------------------------------------------
# Local LLM (Ollama) — disabled by default; see docs/runtime/llm.md
# llm_summary and narrative_summary are in the recommended module preset when enabled.
# Group cross-session synthesis (after collect): analysis.group_llm_synthesis.enabled/effort
# in JSON config — see docs/groups/group_llm_synthesis_contract.md
# Local docker-compose.override.yml defaults these on when unset (host Ollama).
# -----------------------------------------------------------------------------
# 1/true/yes/on to enable LLM-backed modules (llm_summary, narrative_summary)
TRANSCRIPTX_LLM_ENABLED=
# Options: null | ollama (only ollama supported for remote calls today)
TRANSCRIPTX_LLM_PROVIDER=
# Ollama model tag — larger = better summaries, slower (e.g. qwen3:4b, qwen3:8b)
TRANSCRIPTX_LLM_MODEL=
# Host URL for Ollama API (use host.docker.internal from Docker on Mac/Windows)
TRANSCRIPTX_LLM_BASE_URL=
# Fixed seed for reproducible LLM output
TRANSCRIPTX_LLM_SEED=
# Per-request timeout in seconds (default 1350 = 22.5 minutes)
TRANSCRIPTX_LLM_REQUEST_TIMEOUT=
# Provider availability probe timeout in seconds (default 7.5)
TRANSCRIPTX_LLM_AVAILABILITY_TIMEOUT=
# Max transcript characters sent to LLM after prompt wrapping (default 48000)
TRANSCRIPTX_LLM_MAX_INPUT_CHARS=
# Cap on generated tokens (default 2048)
TRANSCRIPTX_LLM_MAX_OUTPUT_TOKENS=
# Default sampling temperature (default 0.3)
TRANSCRIPTX_LLM_DEFAULT_TEMPERATURE=
# 1/true/yes/on = Corrections Studio LLM candidate discovery (also needs LLM above).
# See docs/runtime/corrections-llm.md. Local compose override defaults this on.
TRANSCRIPTX_CORRECTIONS_LLM_ENABLED=

# -----------------------------------------------------------------------------
# Third-party caches (not read by TranscriptX directly; set for ML/NLP stacks)
# -----------------------------------------------------------------------------
# Optional shared cache root for model/resource artifacts used by dependencies
TRANSCRIPTX_CACHE_DIR=
# HF_HOME=
# MPLCONFIGDIR=
# NLTK_DATA=
# STREAMLIT_* variables are typically set in docker-compose, not .env.example.

# -----------------------------------------------------------------------------
# Streamlit load / perf instrumentation (optional)
# -----------------------------------------------------------------------------
# Enable (default) or disable JSONL load-profile sampling for Streamlit pages.
# Unset or 1/true = enabled; 0/false/no/off = disabled.
TRANSCRIPTX_STREAMLIT_PERF=
# Optional override for the JSONL output path (default: $TRANSCRIPTX_DATA_DIR/perf/... or ./perf/...).
TRANSCRIPTX_STREAMLIT_PERF_PATH=
