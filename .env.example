# Copy to `.env` and set values as needed. Repo root `.env` is loaded by
# `transcriptx._bootstrap` before paths/config are resolved.
#
# HOST_* — used by docker-compose.yml for volume mount sources on the host.
# TRANSCRIPTX_* — used by the app (native runs and container env in compose).

# -----------------------------------------------------------------------------
# Docker Compose: host paths for volume mounts
# -----------------------------------------------------------------------------
# Recordings: required for `docker compose`. Use an absolute path outside the git
# clone (your audio library). Create `imports/` there for uploads if needed.
# Example: HOST_RECORDINGS_DIR=/Users/you/Documents/TranscriptX-media/recordings
HOST_TRANSCRIPTS_DIR=
HOST_RECORDINGS_DIR=
HOST_WAV_BACKUP_DIR=
HOST_OUTPUT_DIR=

# -----------------------------------------------------------------------------
# Storage & paths (native / overrides; in Docker these are usually set in compose)
# -----------------------------------------------------------------------------
TRANSCRIPTX_DATA_DIR=
TRANSCRIPTX_CONFIG_DIR=
TRANSCRIPTX_PROFILES_DIR=
TRANSCRIPTX_TRANSCRIPTS_DIR=
TRANSCRIPTX_RECORDINGS_DIR=
TRANSCRIPTX_OUTPUT_DIR=
TRANSCRIPTX_WAV_BACKUP_DIR=
# Deprecated: prefer TRANSCRIPTX_WAV_BACKUP_DIR
TRANSCRIPTX_WAV_STORAGE_DIR=
TRANSCRIPTX_IMPORTS_DIR=

# -----------------------------------------------------------------------------
# Core install profile & optional dependency behavior
# -----------------------------------------------------------------------------
# 1/true/yes/on = core-only (no heavy auto-install paths)
TRANSCRIPTX_CORE=
# 1/true/yes/on = never auto-install optional packages at import time
TRANSCRIPTX_NO_AUTO_INSTALL=
# Default when unset: downloads enabled. 1/true/yes/on = disable downloads
TRANSCRIPTX_DISABLE_DOWNLOADS=
# Unset = allow spaCy model auto-download when needed; 1/true = skip download
TRANSCRIPTX_DISABLE_SPACY_DOWNLOAD=
# 1/true/yes/on = strict env key handling (unknown TRANSCRIPTX_* keys raise)
TRANSCRIPTX_CONFIG_STRICT=
# 1/true/yes/on = allow analysis on transcripts without managed-import sidecar
# (development/tests only; default off for production workflows)
TRANSCRIPTX_ALLOW_UNMANAGED_TRANSCRIPTS=
# spaCy model name (e.g. en_core_web_md, en_core_web_sm)
TRANSCRIPTX_SPACY_MODEL=

# -----------------------------------------------------------------------------
# Web entrypoint defaults (see transcriptx.web.__main__)
# -----------------------------------------------------------------------------
TRANSCRIPTX_HOST=
TRANSCRIPTX_PORT=

# -----------------------------------------------------------------------------
# UI / logging
# -----------------------------------------------------------------------------
# 1/true/yes/on or 0/false/no/off
TRANSCRIPTX_USE_EMOJIS=
TRANSCRIPTX_LOG_LEVEL=
# 1/0 — passed to matplotlib figure max open warning (see lazy_imports)
TRANSCRIPTX_MPL_MAX_OPEN_WARNING=
# 1 = enable Corrections Studio page; other = off
TRANSCRIPTX_ENABLE_CORRECTIONS_STUDIO=

# -----------------------------------------------------------------------------
# Config overrides (applied by env_key_registry.apply_env_to_config via
# env_overrides.apply_transcriptx_env and system_env.apply_env_overrides)
# -----------------------------------------------------------------------------
TRANSCRIPTX_SENTIMENT_WINDOW_SIZE=
TRANSCRIPTX_EMOTION_MODEL=
TRANSCRIPTX_SEMANTIC_MODEL=
# Heartbeat cadence for semantic_similarity_advanced progress logs (seconds)
TRANSCRIPTX_SEMANTIC_PROGRESS_LOG_INTERVAL_SECONDS=
# Heartbeat cadence for long-running module execution logs (seconds)
TRANSCRIPTX_MODULE_PROGRESS_LOG_INTERVAL_SECONDS=
TRANSCRIPTX_ACTS_MODEL=
TRANSCRIPTX_WORDCLOUD_MAX_WORDS=
# JSON list or comma-separated paths
TRANSCRIPTX_WAV_FOLDERS=
TRANSCRIPTX_RECORDINGS_FOLDERS=
# prompt | explore | direct
TRANSCRIPTX_FILE_SELECTION_MODE=

# -----------------------------------------------------------------------------
# Audio preprocessing (modes: selected | auto | suggest | off where applicable)
# -----------------------------------------------------------------------------
TRANSCRIPTX_AUDIO_PREPROCESSING_MODE=
TRANSCRIPTX_AUDIO_CONVERT_TO_MONO=
TRANSCRIPTX_AUDIO_DOWNSAMPLE=
TRANSCRIPTX_AUDIO_TARGET_SAMPLE_RATE=
TRANSCRIPTX_AUDIO_NORMALIZE_MODE=
TRANSCRIPTX_AUDIO_NORMALIZE_ENABLED=
TRANSCRIPTX_AUDIO_TARGET_LUFS=
TRANSCRIPTX_AUDIO_DENOISE_MODE=
TRANSCRIPTX_AUDIO_DENOISE_ENABLED=
TRANSCRIPTX_AUDIO_DENOISE_STRENGTH=
TRANSCRIPTX_AUDIO_HIGHPASS_MODE=
TRANSCRIPTX_AUDIO_HIGHPASS_ENABLED=
TRANSCRIPTX_AUDIO_HIGHPASS_CUTOFF=

# -----------------------------------------------------------------------------
# Speaker gate (workflow.speaker_gate; strings interpreted by gate config)
# -----------------------------------------------------------------------------
TRANSCRIPTX_SPEAKER_GATE_THRESHOLD_VALUE=
TRANSCRIPTX_SPEAKER_GATE_THRESHOLD_TYPE=
TRANSCRIPTX_SPEAKER_GATE_MODE=
TRANSCRIPTX_SPEAKER_GATE_EXEMPLAR_COUNT=

# -----------------------------------------------------------------------------
# Third-party caches (not read by TranscriptX directly; set for ML/NLP stacks)
# -----------------------------------------------------------------------------
# Optional shared cache root for model/resource artifacts used by dependencies
TRANSCRIPTX_CACHE_DIR=
# HF_HOME=
# MPLCONFIGDIR=
# NLTK_DATA=
# STREAMLIT_* variables are typically set in docker-compose, not .env.example.
