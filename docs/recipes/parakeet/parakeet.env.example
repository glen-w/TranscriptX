# Example host env for NeMo Parakeet Run-in-app (Theme H5).
# Copy to parakeet.env and load before starting Streamlit on a CUDA Linux host.

# Select the registered provider (whispermlx remains default on macOS).
TRANSCRIPTX_TRANSCRIPTION_PROVIDER=parakeet_docker

# Dev/CI only — skip GPU weights and docker NeMo run:
# TRANSCRIPTX_PARAKEET_STUB=1

# Optional overrides (also set in Transcribe Audio → Run in app UI):
# TRANSCRIPTX_TRANSCRIPTION_DOCKER_IMAGE=nvcr.io/nvidia/nemo:24.07.1
# TRANSCRIPTX_TRANSCRIPTION_MODEL=nvidia/parakeet-tdt-0.6b-v3
# Host Hugging Face cache (survives docker --rm):
# TRANSCRIPTX_PARAKEET_HF_CACHE=/home/you/.cache/huggingface
