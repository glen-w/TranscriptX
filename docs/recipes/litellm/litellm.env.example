# Example env for the optional LiteLLM sidecar + TranscriptX openai_compatible client.
# Copy next to the compose file or into the host .env used by Streamlit. Never commit keys.

LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-local
LITELLM_UPSTREAM_API_BASE=https://api.openai.com/v1
LITELLM_UPSTREAM_API_KEY=
# LITELLM_UPSTREAM_ANTHROPIC_KEY=

# Point TranscriptX at the sidecar (loopback). Still not a silent cloud default —
# you must set provider + base_url yourself.
TRANSCRIPTX_LLM_ENABLED=1
TRANSCRIPTX_LLM_PROVIDER=openai_compatible
TRANSCRIPTX_LLM_BASE_URL=http://127.0.0.1:4000/v1
TRANSCRIPTX_LLM_MODEL=default
TRANSCRIPTX_LLM_API_KEY=sk-local
