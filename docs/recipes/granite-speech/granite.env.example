# Host Granite Speech (mlx-audio) — copy values into whisperx.env or the shell.
# Never commit secrets. Granite weights are Apache-2.0; first run downloads from Hub.

# TRANSCRIPTX_TRANSCRIPTION_PROVIDER=granite_mlx

# Interpreter that has mlx-audio>=0.5.9 and jinja2 (not the analysis venv).
# MLX_AUDIO_PYTHON=/Users/you/venvs/mlx-audio/bin/python

# GRANITE_SPEECH_MODEL=ibm-granite/granite-speech-5.0-2b

# Dev/CI only — no Hub download:
# TRANSCRIPTX_GRANITE_STUB=1
